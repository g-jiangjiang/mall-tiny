<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.tiny.modules.ums.mapper.UmsAdminLoginFailureMapper">

    <select id="countFailureByTimeRange" resultType="int">
        SELECT COUNT(*) FROM ums_admin_login_failure
        WHERE username = #{username}
        AND failure_time BETWEEN #{startTime} AND #{endTime}
    </select>

    <delete id="deleteFailureBeforeTime">
        DELETE FROM ums_admin_login_failure
        WHERE failure_time &lt; #{beforeTime}
    </delete>

    <select id="getRecentFailures" resultType="com.macro.mall.tiny.modules.ums.model.UmsAdminLoginFailure">
        SELECT * FROM ums_admin_login_failure
        WHERE username = #{username}
        ORDER BY failure_time DESC
        LIMIT #{limit}
    </select>

</mapper>