<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.tiny.modules.ums.mapper.UmsAdminLockedMapper">

    <select id="selectByUsername" resultType="com.macro.mall.tiny.modules.ums.model.UmsAdminLocked">
        SELECT * FROM ums_admin_locked
        WHERE username = #{username}
        LIMIT 1
    </select>

    <delete id="deleteByUsername">
        DELETE FROM ums_admin_locked
        WHERE username = #{username}
    </delete>

</mapper>