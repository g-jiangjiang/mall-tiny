<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.tiny.modules.pms.mapper.PmsAttributeValueMapper">

    <!-- 根据规格属性ID查询属性值列表 -->
    <select id="selectByAttributeId" resultType="com.macro.mall.tiny.modules.pms.model.PmsAttributeValue">
        SELECT *
        FROM pms_attribute_value
        WHERE attribute_id = #{attributeId}
        AND status = 1
        ORDER BY sort ASC
    </select>

</mapper>
